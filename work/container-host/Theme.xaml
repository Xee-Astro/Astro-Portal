<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Text" Color="#EEF3FA"/><SolidColorBrush x:Key="Muted" Color="#B8C5D6"/>
 <SolidColorBrush x:Key="Button" Color="#26354A"/><SolidColorBrush x:Key="Hover" Color="#354A65"/><SolidColorBrush x:Key="Pressed" Color="#182434"/>
 <SolidColorBrush x:Key="Disabled" Color="#18212E"/><SolidColorBrush x:Key="Edge" Color="#8298B3"/>
 <SolidColorBrush x:Key="Field" Color="#202C3D"/><SolidColorBrush x:Key="Accent" Color="#79B8FF"/>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Button}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Edge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
    <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Tag" Value="Accent"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="Black"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Hover}"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Text}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Pressed}"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Text}"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="Tag" Value="{x:Null}"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></MultiTrigger>
    <Trigger Property="Tag" Value="Active"><Setter TargetName="Surface" Property="Background" Value="#62D8A4"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="Black"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Active"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#86E4BB"/></MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Active"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#42BA88"/></MultiTrigger>
    <Trigger Property="Tag" Value="ASIAIR"><Setter TargetName="Surface" Property="Background" Value="#862B36"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="ASIAIR"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#A53744"/></MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="ASIAIR"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#65212A"/></MultiTrigger>
    <Trigger Property="Tag" Value="Stellavita"><Setter TargetName="Surface" Property="Background" Value="#164E87"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Stellavita"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#2164A5"/></MultiTrigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Stellavita"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#10365F"/></MultiTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Disabled}"/><Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Muted}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,2,8,2"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/>
  <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionTextBrush" Value="Black"/><Setter Property="SelectionOpacity" Value="1"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Text}"/></Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="{StaticResource Disabled}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,2,8,2"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="CaretBrush" Value="{StaticResource Text}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Indicator" Width="18" Height="18" Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
     <Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4" Stroke="{StaticResource Text}" StrokeThickness="2" Visibility="Collapsed"/>
    </Border>
    <ContentPresenter x:Name="Label" Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Indicator" Property="Background" Value="{StaticResource Hover}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Muted}"/><Setter TargetName="Indicator" Property="Background" Value="{StaticResource Disabled}"/><Setter TargetName="Tick" Property="Stroke" Value="{StaticResource Muted}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/></Style>
</ResourceDictionary>
